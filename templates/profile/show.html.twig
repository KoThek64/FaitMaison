{% extends 'base.html.twig' %}
{% block title %}{{ user.username }}{% endblock %}

{% block body %}
{% set publishedRecipes = user.recipes|filter(r => r.isPublished) %}
{% set draftRecipes     = user.recipes|filter(r => not r.isPublished) %}
{% set isOwner          = app.user == user %}
{% set isFollowing      = app.user and not isOwner and user.followers|filter(f => f.follower == app.user)|length > 0 %}

<div style="max-width:56rem; margin:0 auto; padding:2.5rem 1.5rem 5rem;">

    {# ── En-tête profil ── #}
    <div style="background:linear-gradient(135deg, var(--color-espresso) 0%, var(--color-espresso-mid) 60%, #3D2015 100%); border-radius:1.75rem; padding:2.25rem 2rem; margin-bottom:2.5rem; position:relative; overflow:hidden;">

        {# Texture de fond #}
        <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(250,244,232,0.025) 1px, transparent 1px); background-size:18px 18px; pointer-events:none;"></div>
        {# Accent décoratif #}
        <div style="position:absolute; top:-4rem; right:-4rem; width:14rem; height:14rem; border-radius:50%; background:radial-gradient(circle, rgba(196,98,45,0.18) 0%, transparent 70%); pointer-events:none;"></div>

        <div style="position:relative; z-index:1; display:flex; align-items:flex-start; gap:1.75rem; flex-wrap:wrap;">

            {# Avatar #}
            {% if user.avatarName %}
                <img src="{{ asset('uploads/recipes/' ~ user.avatarName) }}" alt="{{ user.username }}"
                    style="width:5.5rem; height:5.5rem; border-radius:50%; object-fit:cover; flex-shrink:0; border:2px solid rgba(201,150,58,0.5); box-shadow:0 0 0 4px rgba(201,150,58,0.12);">
            {% else %}
                <div style="width:5.5rem; height:5.5rem; border-radius:50%; background:linear-gradient(135deg, var(--color-terracotta) 0%, var(--color-terracotta-dark) 100%); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:2rem; font-weight:700; color:var(--color-cream); flex-shrink:0; border:2px solid rgba(201,150,58,0.4); box-shadow:0 0 0 4px rgba(201,150,58,0.1);">
                    {{ user.username|first|upper }}
                </div>
            {% endif %}

            {# Infos #}
            <div style="flex:1; min-width:0;">
                <h1 style="font-size:1.75rem; color:var(--color-cream); margin-bottom:0.25rem; line-height:1.15;">{{ user.username }}</h1>
                <p style="font-family:var(--font-crimson); font-size:0.8125rem; color:rgba(250,244,232,0.4); margin-bottom:0.875rem; letter-spacing:0.04em;">
                    Membre depuis {{ user.createdAt|date('F Y') }}
                </p>
                {% if user.bio %}
                    <p style="font-family:var(--font-crimson); font-size:1.0625rem; color:rgba(250,244,232,0.75); line-height:1.6; max-width:34rem; margin-bottom:1.25rem;">{{ user.bio }}</p>
                {% else %}
                    <div style="margin-bottom:1.25rem;"></div>
                {% endif %}

                {# Stats #}
                <div style="display:flex; gap:2rem; flex-wrap:wrap;">
                    <div style="text-align:center;">
                        <div style="font-family:var(--font-playfair); font-size:1.5rem; font-weight:700; color:var(--color-cream); line-height:1;">{{ publishedRecipes|length }}</div>
                        <div style="font-family:var(--font-crimson); font-size:0.75rem; color:rgba(250,244,232,0.45); letter-spacing:0.06em; text-transform:uppercase; margin-top:0.2rem;">Recette{{ publishedRecipes|length > 1 ? 's' : '' }}</div>
                    </div>
                    {% if isOwner %}
                        <div style="width:1px; background:rgba(250,244,232,0.1); align-self:stretch;"></div>
                        <div style="text-align:center;">
                            <div style="font-family:var(--font-playfair); font-size:1.5rem; font-weight:700; color:var(--color-cream); line-height:1;">{{ user.favorites|length }}</div>
                            <div style="font-family:var(--font-crimson); font-size:0.75rem; color:rgba(250,244,232,0.45); letter-spacing:0.06em; text-transform:uppercase; margin-top:0.2rem;">Favori{{ user.favorites|length > 1 ? 's' : '' }}</div>
                        </div>
                    {% endif %}
                    <div style="width:1px; background:rgba(250,244,232,0.1); align-self:stretch;"></div>
                    <div style="text-align:center;">
                        <div style="font-family:var(--font-playfair); font-size:1.5rem; font-weight:700; color:var(--color-cream); line-height:1;">{{ user.followers|length }}</div>
                        <div style="font-family:var(--font-crimson); font-size:0.75rem; color:rgba(250,244,232,0.45); letter-spacing:0.06em; text-transform:uppercase; margin-top:0.2rem;">Abonné{{ user.followers|length > 1 ? 's' : '' }}</div>
                    </div>
                    <div style="width:1px; background:rgba(250,244,232,0.1); align-self:stretch;"></div>
                    <div style="text-align:center;">
                        <div style="font-family:var(--font-playfair); font-size:1.5rem; font-weight:700; color:var(--color-cream); line-height:1;">{{ user.following|length }}</div>
                        <div style="font-family:var(--font-crimson); font-size:0.75rem; color:rgba(250,244,232,0.45); letter-spacing:0.06em; text-transform:uppercase; margin-top:0.2rem;">Abonnement{{ user.following|length > 1 ? 's' : '' }}</div>
                    </div>
                    <div style="width:1px; background:rgba(250,244,232,0.1); align-self:stretch;"></div>
                    <div style="text-align:center;">
                        {% if averageRating > 0 %}
                            <div style="font-family:var(--font-playfair); font-size:1.5rem; font-weight:700; color:var(--color-gold); line-height:1;">{{ averageRating }}</div>
                        {% else %}
                            <div style="font-family:var(--font-playfair); font-size:1.5rem; font-weight:700; color:rgba(250,244,232,0.25); line-height:1;">–</div>
                        {% endif %}
                        <div style="font-family:var(--font-crimson); font-size:0.75rem; color:rgba(250,244,232,0.45); letter-spacing:0.06em; text-transform:uppercase; margin-top:0.2rem;">Note moy.</div>
                    </div>
                </div>
            </div>

            {# Boutons actions #}
            <div style="display:flex; flex-direction:column; gap:0.5rem; flex-shrink:0; align-self:flex-start;">
                {% if isOwner %}
                    <a href="{{ path('app_profile_edit') }}" class="btn-ghost"
                        style="border-color:rgba(250,244,232,0.2); color:rgba(250,244,232,0.65); background:rgba(250,244,232,0.06);">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Modifier
                    </a>
                {% elseif app.user %}
                    <form method="post" action="{{ path('app_follow_toggle', {id: user.id}) }}">
                        <button type="submit"
                            style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.625rem 1.25rem; border-radius:0.625rem; font-family:var(--font-crimson); font-size:0.9375rem; font-weight:600; cursor:pointer; transition:all .2s; white-space:nowrap;
                            {% if isFollowing %}
                                background:rgba(250,244,232,0.1); border:1px solid rgba(250,244,232,0.25); color:rgba(250,244,232,0.8);
                            {% else %}
                                background:var(--color-terracotta); border:1px solid var(--color-terracotta); color:var(--color-cream);
                            {% endif %}">
                            {% if isFollowing %}
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                Abonné
                            {% else %}
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Suivre
                            {% endif %}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Onglets ── #}
    <div style="display:flex; gap:0.25rem; margin-bottom:2rem; border-bottom:2px solid var(--color-cream-border); padding-bottom:0;">
        <button onclick="showTab('recettes')" id="tab-recettes"
            style="font-family:var(--font-crimson); font-size:1rem; font-weight:600; padding:0.625rem 1.25rem; border:none; background:transparent; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; transition:color .2s, border-color .2s; color:var(--color-ink);">
            Recettes
            <span style="font-size:0.8125rem; font-weight:400; margin-left:0.375rem; color:var(--color-sand);">{{ publishedRecipes|length }}</span>
        </button>
        {% if isOwner %}
            <button onclick="showTab('favoris')" id="tab-favoris"
                style="font-family:var(--font-crimson); font-size:1rem; font-weight:600; padding:0.625rem 1.25rem; border:none; background:transparent; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; transition:color .2s, border-color .2s; color:var(--color-ink-muted);">
                Favoris
                <span style="font-size:0.8125rem; font-weight:400; margin-left:0.375rem; color:var(--color-sand);">{{ user.favorites|length }}</span>
            </button>
            {% if draftRecipes|length > 0 %}
                <button onclick="showTab('brouillons')" id="tab-brouillons"
                    style="font-family:var(--font-crimson); font-size:1rem; font-weight:600; padding:0.625rem 1.25rem; border:none; background:transparent; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; transition:color .2s, border-color .2s; color:var(--color-ink-muted);">
                    Brouillons
                    <span style="font-size:0.8125rem; font-weight:400; margin-left:0.375rem; color:var(--color-sand);">{{ draftRecipes|length }}</span>
                </button>
            {% endif %}
        {% endif %}
    </div>

    {# ── Panneau Recettes ── #}
    <div id="panel-recettes">
        {% if publishedRecipes|length == 0 %}
            <div style="text-align:center; padding:4rem 1rem;">
                <div style="font-size:3rem; margin-bottom:1rem; opacity:0.35;">🍽</div>
                <p style="font-family:var(--font-crimson); color:var(--color-sand); font-size:1.0625rem;">Aucune recette publiée pour l'instant.</p>
                {% if isOwner %}
                    <a href="{{ path('app_recipe_add') }}" class="btn-primary" style="margin-top:1.25rem; display:inline-flex;">Ajouter une recette</a>
                {% endif %}
            </div>
        {% else %}
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(17rem, 1fr)); gap:1.5rem;">
                {% for recipe in publishedRecipes %}
                    <a href="{{ path('app_recipe_show', {id: recipe.id}) }}" class="recipe-card" style="text-decoration:none; display:block;">
                        <div class="recipe-card-thumb">
                            {% if recipe.imageName %}
                                <img src="{{ asset('uploads/recipes/' ~ recipe.imageName) }}" alt="{{ recipe.title }}" style="width:100%; height:100%; object-fit:cover; display:block;">
                            {% else %}
                                <span style="font-size:3rem; opacity:0.35; position:relative; z-index:1;">🍽</span>
                            {% endif %}
                        </div>
                        <div style="padding:1.25rem 1.25rem 1rem;">
                            <h3 style="font-family:var(--font-playfair); font-size:1.0625rem; font-weight:600; color:var(--color-ink); margin-bottom:0.5rem; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                {{ recipe.title }}
                            </h3>
                            <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center; font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); margin-bottom:0.875rem;">
                                <span>{{ recipe.category.name }}</span>
                                <span style="color:var(--color-cream-border);">·</span>
                                <span>{{ recipe.duration }} min</span>
                                <span style="color:var(--color-cream-border);">·</span>
                                <span>{{ recipe.servings }} pers.</span>
                            </div>
                            <span class="badge {{ recipe.difficulty == 'facile' ? 'badge-easy' : (recipe.difficulty == 'moyen' ? 'badge-medium' : 'badge-hard') }}">
                                {{ recipe.difficulty }}
                            </span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# ── Panneau Favoris ── #}
    {% if isOwner %}
        <div id="panel-favoris" style="display:none;">
            {% if user.favorites is empty %}
                <div style="text-align:center; padding:4rem 1rem;">
                    <div style="font-size:3rem; margin-bottom:1rem; opacity:0.35;">★</div>
                    <p style="font-family:var(--font-crimson); color:var(--color-sand); font-size:1.0625rem;">Aucun favori enregistré pour l'instant.</p>
                </div>
            {% else %}
                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(17rem, 1fr)); gap:1.5rem;">
                    {% for favori in user.favorites %}
                        {% if favori.recipe %}
                            <a href="{{ path('app_recipe_show', {id: favori.recipe.id}) }}" class="recipe-card" style="text-decoration:none; display:block;">
                                <div class="recipe-card-thumb">
                                    {% if favori.recipe.imageName %}
                                        <img src="{{ asset('uploads/recipes/' ~ favori.recipe.imageName) }}" alt="{{ favori.recipe.title }}" style="width:100%; height:100%; object-fit:cover; display:block;">
                                    {% else %}
                                        <span style="font-size:3rem; opacity:0.35; position:relative; z-index:1;">🍽</span>
                                    {% endif %}
                                    <div style="position:absolute; top:0.625rem; right:0.625rem; z-index:2; background:rgba(201,150,58,0.9); border-radius:50%; width:1.75rem; height:1.75rem; display:flex; align-items:center; justify-content:center; font-size:0.875rem; color:white; backdrop-filter:blur(4px);">★</div>
                                </div>
                                <div style="padding:1.25rem 1.25rem 1rem;">
                                    <h3 style="font-family:var(--font-playfair); font-size:1.0625rem; font-weight:600; color:var(--color-ink); margin-bottom:0.5rem; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                        {{ favori.recipe.title }}
                                    </h3>
                                    <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center; font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); margin-bottom:0.875rem;">
                                        <span>{{ favori.recipe.category.name }}</span>
                                        <span style="color:var(--color-cream-border);">·</span>
                                        <span>{{ favori.recipe.duration }} min</span>
                                        <span style="color:var(--color-cream-border);">·</span>
                                        <span>{{ favori.recipe.servings }} pers.</span>
                                    </div>
                                    <span class="badge {{ favori.recipe.difficulty == 'facile' ? 'badge-easy' : (favori.recipe.difficulty == 'moyen' ? 'badge-medium' : 'badge-hard') }}">
                                        {{ favori.recipe.difficulty }}
                                    </span>
                                </div>
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# ── Panneau Brouillons ── #}
        {% if draftRecipes|length > 0 %}
            <div id="panel-brouillons" style="display:none;">
                <div style="display:flex; flex-direction:column; gap:0.625rem;">
                    {% for recipe in draftRecipes %}
                        <div style="display:flex; align-items:center; gap:1rem; background:white; border-radius:1rem; padding:1rem 1.25rem; box-shadow:0 1px 4px rgba(44,24,16,0.05); border-left:3px solid var(--color-cream-border);">
                            <div style="width:2.75rem; height:2.75rem; border-radius:0.625rem; background:var(--color-parchment); display:flex; align-items:center; justify-content:center; font-size:1.125rem; flex-shrink:0; opacity:0.5;">🍽</div>
                            <div style="flex:1; min-width:0;">
                                <div style="font-family:var(--font-playfair); font-size:1rem; font-weight:600; color:var(--color-ink-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ recipe.title }}</div>
                                <div style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-sand);">Créée le {{ recipe.createdAt|date('d/m/Y') }}</div>
                            </div>
                            <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}"
                                style="display:inline-flex; align-items:center; gap:0.375rem; font-family:var(--font-crimson); font-size:0.875rem; color:var(--color-terracotta); text-decoration:none; padding:0.375rem 0.875rem; border:1px solid var(--color-terracotta-soft); border-radius:0.5rem; white-space:nowrap; transition:background .15s; flex-shrink:0;"
                                onmouseover="this.style.background='var(--color-terracotta-soft)'"
                                onmouseout="this.style.background='transparent'">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Modifier
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    {% endif %}

</div>

<script>
(function () {
    const tabs = ['recettes', 'favoris', 'brouillons'];

    function showTab(name) {
        tabs.forEach(function (t) {
            var panel = document.getElementById('panel-' + t);
            var tab   = document.getElementById('tab-' + t);
            if (panel) panel.style.display = (t === name) ? '' : 'none';
            if (tab) {
                tab.style.color       = (t === name) ? 'var(--color-ink)'       : 'var(--color-ink-muted)';
                tab.style.borderColor = (t === name) ? 'var(--color-terracotta)' : 'transparent';
            }
        });
        try { sessionStorage.setItem('profileTab', name); } catch(e) {}
    }

    // Restaure l'onglet actif au rechargement
    var saved = sessionStorage.getItem('profileTab');
    showTab((saved && document.getElementById('panel-' + saved)) ? saved : 'recettes');

    // Exposition globale pour les boutons onclick
    window.showTab = showTab;
})();
</script>

{% endblock %}
