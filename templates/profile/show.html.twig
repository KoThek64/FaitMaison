{% extends 'base.html.twig' %}
{% block title %}{{ user.username }}{% endblock %}

{% block body %}
<div style="max-width:52rem; margin:0 auto; padding:2.5rem 1.5rem 4rem;">

    {# En-tête profil #}
    <div style="background:linear-gradient(135deg, var(--color-espresso) 0%, var(--color-espresso-mid) 100%); border-radius:1.5rem; padding:2rem; display:flex; align-items:center; gap:1.5rem; margin-bottom:2.5rem; flex-wrap:wrap;">
        {% if user.avatarName %}
            <img src="{{ asset('uploads/recipes/' ~ user.avatarName) }}" alt="{{ user.username }}"
                style="width:4.5rem; height:4.5rem; border-radius:50%; object-fit:cover; flex-shrink:0; border:2px solid rgba(250,244,232,0.15);">
        {% else %}
            <div style="width:4.5rem; height:4.5rem; border-radius:50%; background:var(--color-terracotta); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:1.75rem; font-weight:700; color:var(--color-cream); flex-shrink:0;">
                {{ user.username|first|upper }}
            </div>
        {% endif %}
        <div style="flex:1; min-width:0;">
            <h1 style="font-size:1.625rem; color:var(--color-cream); margin-bottom:0.25rem;">{{ user.username }}</h1>
            {% if user.bio %}
                <p style="font-family:var(--font-crimson); font-size:1rem; color:rgba(250,244,232,0.8); margin-bottom:0.25rem;">{{ user.bio }}</p>
            {% endif %}
            <p style="font-family:var(--font-crimson); font-size:0.875rem; color:rgba(250,244,232,0.5);">
                Membre depuis {{ user.createdAt|date('F Y') }}
            </p>
        </div>
        {% if app.user == user %}
            <a href="{{ path('app_profile_edit') }}" class="btn-ghost"
                style="border-color:rgba(250,244,232,0.2); color:rgba(250,244,232,0.7); background:rgba(250,244,232,0.06); flex-shrink:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Modifier le profil
            </a>
        {% endif %}
    </div>

    {# Recettes publiées #}
    <div class="section-heading">
        <h2 style="font-size:1.375rem;">Recettes publiées</h2>
    </div>

    {% set hasPublished = false %}
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:2.5rem;">
        {% for recipe in user.recipes %}
            {% if recipe.isPublished %}
                {% set hasPublished = true %}
                <a href="{{ path('app_recipe_show', {id: recipe.id}) }}"
                    style="display:flex; align-items:center; gap:1rem; background:white; border-radius:1rem; padding:1rem 1.25rem; text-decoration:none; box-shadow:0 1px 4px rgba(44,24,16,0.06); transition:box-shadow .2s, transform .2s;"
                    onmouseover="this.style.boxShadow='0 4px 16px rgba(44,24,16,0.1)'; this.style.transform='translateX(4px)'"
                    onmouseout="this.style.boxShadow='0 1px 4px rgba(44,24,16,0.06)'; this.style.transform='translateX(0)'">
                    <div style="width:2.75rem; height:2.75rem; border-radius:0.625rem; background:var(--color-parchment); display:flex; align-items:center; justify-content:center; font-size:1.25rem; flex-shrink:0; opacity:0.7;">🍽</div>
                    <span style="font-family:var(--font-playfair); font-size:1rem; font-weight:600; color:var(--color-ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ recipe.title }}</span>
                    <svg style="margin-left:auto; flex-shrink:0; color:var(--color-sand);" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            {% endif %}
        {% endfor %}
        {% if not hasPublished %}
            <p style="font-family:var(--font-crimson); color:var(--color-sand); font-size:0.9375rem; padding:1.5rem 0;">Aucune recette publiée pour l'instant.</p>
        {% endif %}
    </div>

    {# Brouillons (propriétaire uniquement) #}
    {% if app.user == user %}
        {% set hasDraft = false %}
        {% for recipe in user.recipes %}
            {% if not recipe.isPublished %}{% set hasDraft = true %}{% endif %}
        {% endfor %}

        {% if hasDraft %}
            <div class="section-heading" style="margin-top:0.5rem;">
                <h2 style="font-size:1.375rem;">Brouillons</h2>
            </div>
            <div style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:2.5rem;">
                {% for recipe in user.recipes %}
                    {% if not recipe.isPublished %}
                        <div style="display:flex; align-items:center; gap:1rem; background:white; border-radius:1rem; padding:1rem 1.25rem; box-shadow:0 1px 4px rgba(44,24,16,0.06); border-left:3px solid var(--color-cream-border);">
                            <div style="width:2.75rem; height:2.75rem; border-radius:0.625rem; background:var(--color-cream-dark); display:flex; align-items:center; justify-content:center; font-size:1.25rem; flex-shrink:0; opacity:0.5;">🍽</div>
                            <div style="flex:1; min-width:0;">
                                <span style="font-family:var(--font-playfair); font-size:1rem; font-weight:600; color:var(--color-ink-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">{{ recipe.title }}</span>
                                <span style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-sand);">
                                    Créée le {{ recipe.createdAt|date('d/m/Y') }}
                                </span>
                            </div>
                            <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}"
                                style="display:inline-flex; align-items:center; gap:0.375rem; font-family:var(--font-crimson); font-size:0.875rem; color:var(--color-terracotta); text-decoration:none; white-space:nowrap; padding:0.375rem 0.875rem; border:1px solid var(--color-terracotta-soft); border-radius:0.5rem; transition:background .15s;"
                                onmouseover="this.style.background='var(--color-terracotta-soft)'"
                                onmouseout="this.style.background='transparent'">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Modifier
                            </a>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}

    {# Favoris (propriétaire uniquement) #}
    {% if app.user == user %}
        <div class="section-heading">
            <h2 style="font-size:1.375rem;">Mes favoris</h2>
        </div>
        <div style="display:flex; flex-direction:column; gap:0.75rem;">
            {% if user.favorites is empty %}
                <p style="font-family:var(--font-crimson); color:var(--color-sand); font-size:0.9375rem; padding:1.5rem 0;">Aucun favori pour l'instant.</p>
            {% else %}
                {% for favori in user.favorites %}
                    {% if favori.recipe %}
                        <a href="{{ path('app_recipe_show', {id: favori.recipe.id}) }}"
                            style="display:flex; align-items:center; gap:1rem; background:white; border-radius:1rem; padding:1rem 1.25rem; text-decoration:none; box-shadow:0 1px 4px rgba(44,24,16,0.06); transition:box-shadow .2s, transform .2s;"
                            onmouseover="this.style.boxShadow='0 4px 16px rgba(44,24,16,0.1)'; this.style.transform='translateX(4px)'"
                            onmouseout="this.style.boxShadow='0 1px 4px rgba(44,24,16,0.06)'; this.style.transform='translateX(0)'">
                            <div style="width:2.75rem; height:2.75rem; border-radius:0.625rem; background:var(--color-gold-soft); display:flex; align-items:center; justify-content:center; font-size:1.125rem; flex-shrink:0; color:var(--color-gold);">★</div>
                            <span style="font-family:var(--font-playfair); font-size:1rem; font-weight:600; color:var(--color-ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ favori.recipe.title }}</span>
                            <svg style="margin-left:auto; flex-shrink:0; color:var(--color-sand);" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </div>
    {% endif %}

</div>
{% endblock %}
