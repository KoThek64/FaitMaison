{% extends 'base.html.twig' %}

{% block title %}Page d'acceuil{% endblock %}

{% block body %}
    <h1>Dernières recettes</h1>
    {% for recipe in recipes %}
        <a href="{{ path('app_recipe_show', {id: recipe.id}) }}">{{ recipe.title }}</a>
        {{ recipe.category.name }}
        {{ recipe.difficulty }}
    {% else %}
        <h1>Aucunes recettes publiées</h1>
    {% endfor %}
{% endblock %}
