{% extends 'base.html.twig' %}
{% block title %}Accueil{% endblock %}

{% block body %}

    {# ── Hero ── #}
    <div style="position:relative; overflow:hidden; background:linear-gradient(135deg, var(--color-espresso) 0%, var(--color-espresso-mid) 40%, #4A2518 100%); padding:5rem 2rem 4rem;">

        {# Décoration typographique de fond #}
        <div aria-hidden="true" style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; overflow:hidden; user-select:none;">
            <span style="font-family:var(--font-playfair); font-size:clamp(8rem,20vw,18rem); font-weight:700; font-style:italic; color:rgba(250,244,232,0.025); white-space:nowrap; letter-spacing:-0.03em; line-height:1;">
                Fait Maison
            </span>
        </div>

        {# Contenu du hero #}
        <div style="position:relative; z-index:1; max-width:42rem; margin:0 auto; text-align:center;">
            <div style="display:inline-flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem;">
                <span style="height:1px; width:2.5rem; background:var(--color-terracotta); display:block;"></span>
                <span style="font-family:var(--font-crimson); font-size:0.8125rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--color-terracotta-soft);">Cuisine maison</span>
                <span style="height:1px; width:2.5rem; background:var(--color-terracotta); display:block;"></span>
            </div>

            <h1 style="font-family:var(--font-playfair); font-size:clamp(2.25rem,5vw,3.5rem); font-weight:700; color:var(--color-cream); line-height:1.15; margin-bottom:1rem;">
                Des recettes <em>maison</em>,<br>partagées avec amour
            </h1>
            <p style="font-family:var(--font-crimson); font-size:1.125rem; color:rgba(250,244,232,0.6); margin-bottom:2.5rem;">
                Découvrez des recettes authentiques créées par notre communauté
            </p>

            {# Barre de recherche #}
            <form action="{{ path('app_recipe') }}" method="get"
                style="display:flex; background:white; border-radius:0.875rem; overflow:hidden; box-shadow:0 8px 32px rgba(0,0,0,0.25); max-width:36rem; margin:0 auto;">
                <input type="text" name="recipe_filter[search]" placeholder="Poulet rôti, tarte tatin…"
                    style="flex:1; padding:1rem 1.25rem; border:none; font-family:var(--font-crimson); font-size:1rem; color:var(--color-ink); outline:none; background:transparent; border-radius:0; box-shadow:none;">
                <button type="submit" class="btn-primary" style="border-radius:0; padding:0.875rem 1.75rem; flex-shrink:0;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Chercher
                </button>
            </form>
        </div>
    </div>

    {# ── Recettes récentes ── #}
    <div style="padding:3rem 2rem 4rem; max-width:80rem; margin:0 auto;">
        <div class="section-heading">
            <h2 style="font-size:1.625rem;">Dernières recettes</h2>
        </div>

        {% if recipes is empty %}
            <div style="text-align:center; padding:5rem 2rem; color:var(--color-sand);">
                <div style="font-size:3rem; margin-bottom:1rem; opacity:0.4;">🍽</div>
                <p style="font-family:var(--font-crimson); font-size:1.125rem;">Aucune recette publiée pour l'instant.</p>
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('app_recipe_add') }}" class="btn-primary" style="margin-top:1.5rem; display:inline-flex;">Publier la première recette</a>
                {% endif %}
            </div>
        {% else %}
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(17rem, 1fr)); gap:1.5rem;">
                {% for recipe in recipes %}
                    <div class="recipe-card" style="display:flex; flex-direction:column;">
                        <a href="{{ path('app_recipe_show', {id: recipe.id}) }}" style="text-decoration:none; display:block; flex:1;">
                            <div class="recipe-card-thumb">
                                {% if recipe.imageName %}
                                    <img src="{{ asset('uploads/recipes/' ~ recipe.imageName) }}" alt="{{ recipe.title }}" style="width:100%; height:100%; object-fit:cover; display:block;">
                                {% else %}
                                    <span style="font-size:3rem; opacity:0.35; position:relative; z-index:1;">🍽</span>
                                {% endif %}
                            </div>
                            <div style="padding:1.25rem 1.25rem 0.875rem;">
                                <h3 style="font-family:var(--font-playfair); font-size:1.0625rem; font-weight:600; color:var(--color-ink); margin-bottom:0.5rem; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                    {{ recipe.title }}
                                </h3>
                                <div style="display:flex; flex-wrap:wrap; gap:0.625rem; align-items:center; font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); margin-bottom:0.875rem;">
                                    <span>{{ recipe.category.name }}</span>
                                    <span style="color:var(--color-cream-border);">·</span>
                                    <span>{{ recipe.duration }} min</span>
                                    <span style="color:var(--color-cream-border);">·</span>
                                    <span>{{ recipe.servings }} pers.</span>
                                </div>
                                <span class="badge {{ recipe.difficulty == 'facile' ? 'badge-easy' : (recipe.difficulty == 'moyen' ? 'badge-medium' : 'badge-hard') }}">
                                    {{ recipe.difficulty }}
                                </span>
                                {% if recipe.tags|length > 0 %}
                                    <div style="display:flex; flex-wrap:wrap; gap:0.3rem; margin-top:0.625rem;">
                                        {% for tag in recipe.tags|slice(0, 3) %}
                                            <span style="font-family:var(--font-crimson); font-size:0.75rem; padding:0.15rem 0.625rem; border-radius:999px; background:var(--color-cream); border:1px solid var(--color-cream-border); color:var(--color-ink-muted);">{{ tag.name }}</span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                        <a href="{{ path('app_profile_show', {id: recipe.author.id}) }}"
                            style="display:flex; align-items:center; gap:0.625rem; padding:0.75rem 1.25rem; border-top:1px solid var(--color-cream-border); text-decoration:none; transition:background .15s; border-radius:0 0 1.25rem 1.25rem;"
                            onmouseover="this.style.background='var(--color-cream)'"
                            onmouseout="this.style.background='transparent'">
                            {% if recipe.author.avatarName %}
                                <img src="{{ asset('uploads/recipes/' ~ recipe.author.avatarName) }}" alt="{{ recipe.author.username }}"
                                    style="width:1.5rem; height:1.5rem; border-radius:50%; object-fit:cover; flex-shrink:0;">
                            {% else %}
                                <div style="width:1.5rem; height:1.5rem; border-radius:50%; background:var(--color-terracotta); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:0.625rem; font-weight:700; color:var(--color-cream); flex-shrink:0;">
                                    {{ recipe.author.username|first|upper }}
                                </div>
                            {% endif %}
                            <span style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ recipe.author.username }}</span>
                        </a>
                    </div>
                {% endfor %}
            </div>

            <div style="text-align:center; margin-top:3rem;">
                <a href="{{ path('app_recipe') }}" class="btn-ghost" style="font-size:0.9375rem;">
                    Voir toutes les recettes
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
            </div>
        {% endif %}
    </div>

{% endblock %}
