<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %} — Fait Maison</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body style="background:var(--color-cream); min-height:100vh;">

    {# ── Sidebar ── #}
    <aside id="sidebar"
        class="sidebar-root fixed inset-y-0 left-0 z-40 flex flex-col"
        style="width:16rem; transform:translateX(-100%); transition:transform .3s ease;"
    >
        {# Logo #}
        <div style="padding:1.75rem 1.5rem 1.5rem; border-bottom:1px solid rgba(250,244,232,0.08); position:relative; z-index:1;">
            <a href="{{ path('app_home') }}" style="display:block; text-decoration:none;">
                <span style="font-family:var(--font-playfair); font-size:1.5rem; font-weight:700; font-style:italic; color:var(--color-cream); letter-spacing:-0.01em; line-height:1.1;">
                    Fait Maison
                </span>
                <span style="display:block; width:2rem; height:2px; background:var(--color-terracotta); margin-top:0.5rem; border-radius:1px;"></span>
            </a>
        </div>

        {# Navigation #}
        <nav style="flex:1; padding:1rem 0.75rem; overflow-y:auto; position:relative; z-index:1;">
            <div style="margin-bottom:0.25rem;">
                <a href="{{ path('app_home') }}" class="sidebar-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Accueil
                </a>
                <a href="{{ path('app_recipe') }}" class="sidebar-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    Recettes
                </a>
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('app_recipe_add') }}" class="sidebar-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                        Ajouter une recette
                    </a>
                    <a href="{{ path('app_profile_show', {id: app.user.id}) }}" class="sidebar-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Mon profil
                    </a>
                {% endif %}
            </div>
        </nav>

        {# User zone #}
        <div style="padding:1rem 0.75rem 1.5rem; border-top:1px solid rgba(250,244,232,0.08); position:relative; z-index:1;">
            {% if is_granted('ROLE_USER') %}
                <div style="display:flex; align-items:center; gap:0.75rem; padding:0 0.25rem 0.75rem; margin-bottom:0.5rem; border-bottom:1px solid rgba(250,244,232,0.06);">
                    <div style="width:2.25rem; height:2.25rem; border-radius:50%; background:var(--color-terracotta); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:1rem; font-weight:700; color:var(--color-cream); flex-shrink:0;">
                        {{ app.user.username|first|upper }}
                    </div>
                    <div style="min-width:0;">
                        <div style="font-family:var(--font-crimson); font-size:0.875rem; font-weight:600; color:rgba(250,244,232,0.9); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ app.user.username }}</div>
                        <div style="font-family:var(--font-crimson); font-size:0.75rem; color:rgba(250,244,232,0.4);">Membre</div>
                    </div>
                </div>
                <a href="{{ path('app_logout') }}" class="sidebar-link" style="justify-content:center; border:1px solid rgba(250,244,232,0.12);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Déconnexion
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-primary" style="width:100%; margin-bottom:0.5rem; border-radius:0.625rem;">
                    Se connecter
                </a>
                <a href="{{ path('app_register') }}" class="btn-ghost" style="width:100%; border-color:rgba(250,244,232,0.15); color:rgba(250,244,232,0.6);">
                    S'inscrire
                </a>
            {% endif %}
        </div>
    </aside>

    {# ── Overlay mobile ── #}
    <div id="overlay" class="hidden" style="position:fixed; inset:0; background:rgba(26,13,6,0.6); backdrop-filter:blur(2px); z-index:30;"></div>

    {# ── Contenu principal ── #}
    <div id="main-content" style="min-height:100vh; transition:margin-left .3s ease;">

        {# Header mobile #}
        <header style="display:none; position:sticky; top:0; z-index:20; background:white; box-shadow:0 1px 0 var(--color-cream-border); padding:0.875rem 1rem; align-items:center; gap:1rem;" id="mobile-header">
            <button id="toggle-sidebar" aria-label="Menu" style="padding:0.5rem; border-radius:0.5rem; border:1px solid var(--color-cream-border); background:transparent; cursor:pointer; color:var(--color-ink-muted); display:flex; align-items:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <span style="font-family:var(--font-playfair); font-size:1.25rem; font-weight:700; font-style:italic; color:var(--color-terracotta);">Fait Maison</span>
        </header>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-{{ label == 'success' ? 'success' : (label == 'error' ? 'error' : 'info') }}"
                    style="margin:1rem 1.5rem 0; padding:0.875rem 1rem; border-radius:0.75rem; font-family:var(--font-crimson); font-size:0.9375rem;">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <main>
            {% block body %}{% endblock %}
        </main>
    </div>

    {# ── Responsive sidebar script ── #}
    <script>
        (function() {
            const mq = window.matchMedia('(min-width: 1024px)');
            const sidebar = document.getElementById('sidebar');
            const main = document.getElementById('main-content');
            const mobileHeader = document.getElementById('mobile-header');

            function applyLayout(isDesktop) {
                if (isDesktop) {
                    sidebar.style.transform = 'translateX(0)';
                    main.style.marginLeft = '16rem';
                    mobileHeader.style.display = 'none';
                } else {
                    sidebar.style.transform = 'translateX(-100%)';
                    main.style.marginLeft = '0';
                    mobileHeader.style.display = 'flex';
                }
            }

            applyLayout(mq.matches);
            mq.addEventListener('change', e => applyLayout(e.matches));
        })();
    </script>

</body>
</html>
