<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %} - Fait Maison</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-amber-50 min-h-screen">

    {# Sidebar #}
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 bg-orange-900 text-orange-50 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
        <div class="p-6 border-b border-orange-800">
            <a href="{{ path('app_home') }}" class="font-playfair text-2xl font-bold text-white hover:text-orange-200 transition-colors">
                🍳 Fait Maison
            </a>
        </div>

        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-orange-800 transition-colors text-orange-100 hover:text-white text-sm">
                🏠 Accueil
            </a>
            <a href="{{ path('app_recipe') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-orange-800 transition-colors text-orange-100 hover:text-white text-sm">
                📖 Recettes
            </a>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_recipe_add') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-orange-800 transition-colors text-orange-100 hover:text-white text-sm">
                    ✏️ Ajouter une recette
                </a>
                <a href="{{ path('app_profile_show', {id: app.user.id}) }}" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-orange-800 transition-colors text-orange-100 hover:text-white text-sm">
                    👤 Mon profil
                </a>
            {% endif %}
        </nav>

        <div class="p-4 border-t border-orange-800">
            {% if is_granted('ROLE_USER') %}
                <div class="flex items-center gap-3 mb-3 px-2">
                    <div class="w-8 h-8 rounded-full bg-orange-500 flex items-center justify-center text-white font-bold text-sm shrink-0">
                        {{ app.user.username|first|upper }}
                    </div>
                    <span class="text-orange-100 text-sm font-medium truncate">{{ app.user.username }}</span>
                </div>
                <a href="{{ path('app_logout') }}" class="flex items-center justify-center w-full px-4 py-2 rounded-xl bg-orange-800 hover:bg-orange-700 transition-colors text-orange-100 text-sm">
                    Déconnexion
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="flex items-center justify-center w-full px-4 py-2 mb-2 rounded-full bg-orange-500 hover:bg-orange-400 transition-colors text-white text-sm font-medium">
                    Connexion
                </a>
                <a href="{{ path('app_register') }}" class="flex items-center justify-center w-full px-4 py-2 rounded-full border border-orange-600 hover:bg-orange-800 transition-colors text-orange-100 text-sm">
                    Inscription
                </a>
            {% endif %}
        </div>
    </aside>

    {# Overlay mobile #}
    <div id="overlay" class="fixed inset-0 bg-black/50 z-30 hidden lg:hidden"></div>

    {# Contenu principal #}
    <div class="lg:ml-64 min-h-screen flex flex-col">

        {# Header mobile #}
        <header class="lg:hidden sticky top-0 z-20 bg-white shadow-sm flex items-center gap-4 px-4 py-3">
            <button id="toggle-sidebar" class="p-2 rounded-lg text-gray-600 hover:bg-orange-50 hover:text-orange-600 transition-colors" aria-label="Menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
            <a href="{{ path('app_home') }}" class="font-playfair text-xl font-bold text-orange-700">🍳 Fait Maison</a>
        </header>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mx-6 mt-4 px-4 py-3 rounded-xl text-sm font-medium
                    {% if label == 'success' %}bg-green-100 text-green-800 border border-green-200
                    {% elseif label == 'error' %}bg-red-100 text-red-800 border border-red-200
                    {% else %}bg-orange-100 text-orange-800 border border-orange-200{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>
    </div>

</body>
</html>
