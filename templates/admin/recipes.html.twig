{% extends 'base.html.twig' %}
{% block title %}Admin — Recettes{% endblock %}

{% block body %}
<div style="padding:2.5rem 2rem 4rem; max-width:90rem; margin:0 auto;">

    {# En-tête #}
    <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
        <div>
            <div style="display:inline-flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
                <a href="{{ path('app_admin_dashboard') }}" style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-terracotta); text-decoration:none; letter-spacing:0.1em; text-transform:uppercase; display:flex; align-items:center; gap:0.375rem;"
                    onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Administration
                </a>
            </div>
            <h1 style="font-family:var(--font-playfair); font-size:1.875rem; font-weight:700; color:var(--color-ink);">Recettes</h1>
        </div>
    </div>

    {# Filtres #}
    <form method="get" action="{{ path('app_admin_recipe') }}"
        style="display:flex; flex-wrap:wrap; gap:0.75rem; align-items:flex-end; margin-bottom:1.5rem;">
        <input type="text" name="search" value="{{ filters.search }}" placeholder="Titre ou auteur…"
            style="height:2.75rem; padding:0 0.875rem; border-radius:0.625rem; border:1px solid var(--color-cream-border); font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink); background:white; outline:none; min-width:14rem;"
            onfocus="this.style.borderColor='var(--color-terracotta)'" onblur="this.style.borderColor='var(--color-cream-border)'">
        <select name="status"
            style="height:2.75rem; padding:0 0.875rem; border-radius:0.625rem; border:1px solid var(--color-cream-border); font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink); background:white; outline:none; cursor:pointer;"
            onfocus="this.style.borderColor='var(--color-terracotta)'" onblur="this.style.borderColor='var(--color-cream-border)'">
            <option value="">Tous les statuts</option>
            <option value="published" {{ filters.status == 'published' ? 'selected' : '' }}>Publiée</option>
            <option value="draft" {{ filters.status == 'draft' ? 'selected' : '' }}>Brouillon</option>
            <option value="unpublished" {{ filters.status == 'unpublished' ? 'selected' : '' }}>Dépubliée par admin</option>
        </select>
        <button type="submit" class="btn-primary">Filtrer</button>
        {% if filters.search or filters.status %}
            <a href="{{ path('app_admin_recipe') }}" class="btn-ghost">Réinitialiser</a>
        {% endif %}
    </form>

    {# Tableau #}
    <div class="content-card" style="padding:0; overflow:hidden;">
        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-family:var(--font-crimson); font-size:0.9375rem;">
                <thead>
                    <tr style="border-bottom:2px solid var(--color-cream-border); background:var(--color-cream);">
                        <th style="padding:0.875rem 1.25rem; text-align:left; font-weight:600; color:var(--color-ink); white-space:nowrap;">Recette</th>
                        <th style="padding:0.875rem 1rem; text-align:left; font-weight:600; color:var(--color-ink); white-space:nowrap;">Auteur</th>
                        <th style="padding:0.875rem 1rem; text-align:center; font-weight:600; color:var(--color-ink); white-space:nowrap;">Statut</th>
                        <th style="padding:0.875rem 1rem; text-align:center; font-weight:600; color:var(--color-ink); white-space:nowrap;">Likes</th>
                        <th style="padding:0.875rem 1rem; text-align:center; font-weight:600; color:var(--color-ink); white-space:nowrap;">Commentaires</th>
                        <th style="padding:0.875rem 1rem; text-align:left; font-weight:600; color:var(--color-ink); white-space:nowrap;">Date</th>
                        <th style="padding:0.875rem 1.25rem; text-align:right; font-weight:600; color:var(--color-ink); white-space:nowrap;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for recipe in recipes %}
                        <tr style="border-bottom:1px solid var(--color-cream-border); transition:background .15s;"
                            onmouseover="this.style.background='var(--color-cream)'"
                            onmouseout="this.style.background='transparent'">

                            <td style="padding:1rem 1.25rem; max-width:18rem;">
                                <a href="{{ path('app_recipe_show', {id: recipe.id}) }}"
                                    style="color:var(--color-ink); text-decoration:none; font-weight:500; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; line-height:1.4;"
                                    onmouseover="this.style.color='var(--color-terracotta)'"
                                    onmouseout="this.style.color='var(--color-ink)'">
                                    {{ recipe.title }}
                                </a>
                                {% if recipe.adminNote %}
                                    <div style="margin-top:0.375rem; font-size:0.8125rem; color:#9B3220; background:#FEF2F2; border:1px solid #FECACA; border-radius:0.375rem; padding:0.25rem 0.5rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                        Note : {{ recipe.adminNote }}
                                    </div>
                                {% endif %}
                            </td>

                            <td style="padding:1rem; white-space:nowrap;">
                                <a href="{{ path('app_profile_show', {id: recipe.author.id}) }}"
                                    style="color:var(--color-terracotta); text-decoration:none;"
                                    onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">
                                    {{ recipe.author.username }}
                                </a>
                            </td>

                            <td style="padding:1rem; text-align:center;">
                                {% if recipe.isPublished %}
                                    <span style="display:inline-flex; align-items:center; gap:0.3rem; font-size:0.8125rem; font-weight:500; padding:0.25rem 0.625rem; border-radius:999px; background:#D1FAE5; color:#065F46;">
                                        <span style="width:6px; height:6px; border-radius:50%; background:#10B981; display:inline-block;"></span>
                                        Publiée
                                    </span>
                                {% elseif recipe.adminNote %}
                                    <span style="display:inline-flex; align-items:center; gap:0.3rem; font-size:0.8125rem; font-weight:500; padding:0.25rem 0.625rem; border-radius:999px; background:#FEF2F2; color:#9B3220; border:1px solid #FECACA;">
                                        <span style="width:6px; height:6px; border-radius:50%; background:#EF4444; display:inline-block;"></span>
                                        Dépubliée
                                    </span>
                                {% else %}
                                    <span style="display:inline-flex; align-items:center; gap:0.3rem; font-size:0.8125rem; font-weight:500; padding:0.25rem 0.625rem; border-radius:999px; background:#F3F4F6; color:#6B7280;">
                                        <span style="width:6px; height:6px; border-radius:50%; background:#9CA3AF; display:inline-block;"></span>
                                        Brouillon
                                    </span>
                                {% endif %}
                            </td>

                            <td style="padding:1rem; text-align:center; color:var(--color-ink-muted);">
                                {{ recipe.likes|length }}
                            </td>

                            <td style="padding:1rem; text-align:center; color:var(--color-ink-muted);">
                                {{ recipe.comments|length }}
                            </td>

                            <td style="padding:1rem; color:var(--color-ink-muted); white-space:nowrap; font-size:0.875rem;">
                                {{ recipe.createdAt|date('d/m/Y') }}
                            </td>

                            <td style="padding:1rem 1.25rem; text-align:right; white-space:nowrap;">
                                <div style="display:flex; gap:0.5rem; justify-content:flex-end; align-items:center;">
                                    {% if recipe.isPublished %}
                                        <button type="button"
                                            onclick="openUnpublishModal({{ recipe.id }}, {{ recipe.title|json_encode }})"
                                            style="font-family:var(--font-crimson); font-size:0.875rem; padding:0.375rem 0.75rem; border-radius:0.5rem; border:1px solid #FCD34D; background:transparent; color:#92400E; cursor:pointer; transition:all .15s;"
                                            onmouseover="this.style.background='#FEF3C7'" onmouseout="this.style.background='transparent'">
                                            Dépublier
                                        </button>
                                    {% elseif recipe.adminNote %}
                                        <form method="post" action="{{ path('app_admin_recipe_republish', {id: recipe.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_recipe_' ~ recipe.id) }}">
                                            <button type="submit"
                                                style="font-family:var(--font-crimson); font-size:0.875rem; padding:0.375rem 0.75rem; border-radius:0.5rem; border:1px solid #6EE7B7; background:transparent; color:#065F46; cursor:pointer; transition:all .15s;"
                                                onmouseover="this.style.background='#D1FAE5'" onmouseout="this.style.background='transparent'">
                                                Republier
                                            </button>
                                        </form>
                                    {% endif %}

                                    <button type="button"
                                        onclick="openDeleteRecipeModal({{ recipe.id }}, {{ recipe.title|json_encode }})"
                                        style="font-family:var(--font-crimson); font-size:0.875rem; padding:0.375rem 0.75rem; border-radius:0.5rem; border:1px solid #FECACA; background:transparent; color:#9B3220; cursor:pointer; transition:all .15s;"
                                        onmouseover="this.style.background='#FEF2F2'" onmouseout="this.style.background='transparent'">
                                        Supprimer
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="padding:3rem; text-align:center; color:var(--color-sand); font-family:var(--font-crimson);">
                                Aucune recette.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

{# ── Modal dépublier ── #}
<div id="modal-unpublish" style="display:none; position:fixed; inset:0; z-index:100; align-items:center; justify-content:center; padding:1rem;">
    <div style="position:absolute; inset:0; background:rgba(26,13,6,0.6); backdrop-filter:blur(2px);" onclick="closeModal('modal-unpublish')"></div>
    <div style="position:relative; background:white; border-radius:1.25rem; padding:2rem; width:100%; max-width:30rem; box-shadow:0 20px 60px rgba(26,13,6,0.2);">
        <h2 style="font-family:var(--font-playfair); font-size:1.25rem; font-weight:700; color:var(--color-ink); margin-bottom:0.5rem;">Dépublier la recette</h2>
        <p id="unpublish-title" style="font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink-muted); margin-bottom:1.25rem;"></p>
        <form id="unpublish-form" method="post">
            <input type="hidden" name="_token" id="unpublish-token" value="">
            <div style="margin-bottom:1.25rem;">
                <label style="display:block; font-family:var(--font-crimson); font-size:0.9375rem; font-weight:600; color:var(--color-ink); margin-bottom:0.5rem;">
                    Motif de dépublication <span style="color:#9B3220;">*</span>
                </label>
                <textarea name="note" rows="4" required
                    placeholder="Expliquez à l'auteur pourquoi sa recette a été dépubliée…"
                    style="width:100%; box-sizing:border-box; padding:0.75rem; border-radius:0.625rem; border:1px solid var(--color-cream-border); font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink); background:var(--color-cream); resize:vertical; outline:none;"
                    onfocus="this.style.borderColor='var(--color-terracotta)'"
                    onblur="this.style.borderColor='var(--color-cream-border)'"></textarea>
            </div>
            <div style="display:flex; gap:0.75rem; justify-content:flex-end;">
                <button type="button" onclick="closeModal('modal-unpublish')" class="btn-ghost">Annuler</button>
                <button type="submit" class="btn-primary" style="background:#92400E; border-color:#92400E;">Dépublier</button>
            </div>
        </form>
    </div>
</div>

{# ── Modal supprimer recette ── #}
<div id="modal-delete-recipe" style="display:none; position:fixed; inset:0; z-index:100; align-items:center; justify-content:center; padding:1rem;">
    <div style="position:absolute; inset:0; background:rgba(26,13,6,0.6); backdrop-filter:blur(2px);" onclick="closeModal('modal-delete-recipe')"></div>
    <div style="position:relative; background:white; border-radius:1.25rem; padding:2rem; width:100%; max-width:26rem; box-shadow:0 20px 60px rgba(26,13,6,0.2);">
        <h2 style="font-family:var(--font-playfair); font-size:1.25rem; font-weight:700; color:var(--color-ink); margin-bottom:0.5rem;">Supprimer la recette</h2>
        <p style="font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink-muted); margin-bottom:0.375rem;">
            Vous êtes sur le point de supprimer :
        </p>
        <p id="delete-recipe-title" style="font-family:var(--font-crimson); font-size:0.9375rem; font-weight:600; color:var(--color-ink); margin-bottom:1.25rem;"></p>
        <p style="font-family:var(--font-crimson); font-size:0.875rem; color:#9B3220; background:#FEF2F2; border:1px solid #FECACA; border-radius:0.5rem; padding:0.625rem 0.875rem; margin-bottom:1.5rem;">
            Cette action est irréversible.
        </p>
        <form id="delete-recipe-form" method="post">
            <input type="hidden" name="_token" id="delete-recipe-token" value="">
            <div style="display:flex; gap:0.75rem; justify-content:flex-end;">
                <button type="button" onclick="closeModal('modal-delete-recipe')" class="btn-ghost">Annuler</button>
                <button type="submit" class="btn-primary" style="background:#9B3220; border-color:#9B3220;">Supprimer définitivement</button>
            </div>
        </form>
    </div>
</div>

<script>
function openModal(id) { document.getElementById(id).style.display = 'flex'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }

function openUnpublishModal(id, title) {
    document.getElementById('unpublish-form').action = '/admin/recette/' + id + '/depublier';
    document.getElementById('unpublish-token').value = '';
    document.getElementById('unpublish-title').textContent = '« ' + title + ' »';
    openModal('modal-unpublish');
}

function openDeleteRecipeModal(id, title) {
    document.getElementById('delete-recipe-form').action = '/admin/recette/' + id + '/supprimer';
    document.getElementById('delete-recipe-token').value = '';
    document.getElementById('delete-recipe-title').textContent = '« ' + title + ' »';
    openModal('modal-delete-recipe');
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeModal('modal-unpublish');
        closeModal('modal-delete-recipe');
    }
});
</script>
{% endblock %}
