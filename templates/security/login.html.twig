{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center px-4 py-12">
        <div class="bg-white rounded-2xl shadow-lg p-8 w-full max-w-md">
            <h1 class="font-playfair text-3xl font-bold text-gray-800 mb-1 text-center">Connexion</h1>
            <p class="text-gray-500 text-sm text-center mb-6">Bon retour parmi nous !</p>

            {% if error %}
                <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="space-y-4">
                <div>
                    <label for="inputEmail" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                        autocomplete="email" required autofocus
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm">
                </div>
                <div>
                    <label for="inputPassword" class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword"
                        autocomplete="current-password" required
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm">
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="w-full py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-full font-medium transition-colors">
                    Se connecter
                </button>
            </form>

            <p class="text-center text-sm text-gray-500 mt-4">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}" class="text-orange-600 hover:underline font-medium">Inscription</a>
            </p>
        </div>
    </div>
{% endblock %}
