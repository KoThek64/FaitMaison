{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}

{% block body %}
<div style="min-height:80vh; display:flex; align-items:center; justify-content:center; padding:2rem 1rem;">
    <div style="width:100%; max-width:26rem;">

        {# Décoration #}
        <div style="text-align:center; margin-bottom:2rem;">
            <div style="font-family:var(--font-playfair); font-size:2.5rem; font-weight:700; font-style:italic; color:var(--color-terracotta); line-height:1; margin-bottom:0.5rem;">Fait Maison</div>
            <div style="width:2.5rem; height:2px; background:var(--color-terracotta); margin:0 auto 1rem; border-radius:1px;"></div>
            <h1 style="font-size:1.5rem; margin-bottom:0.25rem;">Bon retour</h1>
            <p style="font-family:var(--font-crimson); color:var(--color-ink-muted); font-size:0.9375rem;">Connectez-vous pour accéder à vos recettes</p>
        </div>

        <div class="form-card">
            {% if error %}
                <div class="flash-error" style="padding:0.75rem 1rem; border-radius:0.625rem; margin-bottom:1.25rem; font-family:var(--font-crimson); font-size:0.9375rem;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" style="display:flex; flex-direction:column; gap:1.125rem;">
                <div>
                    <label for="inputEmail">Adresse e-mail</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                        autocomplete="email" required autofocus placeholder="vous@exemple.fr">
                </div>
                <div>
                    <label for="inputPassword">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword"
                        autocomplete="current-password" required placeholder="••••••••">
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn-primary" style="width:100%; padding:0.875rem; font-size:1rem; margin-top:0.25rem;">
                    Se connecter
                </button>
            </form>
        </div>

        <p style="text-align:center; font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink-muted); margin-top:1.5rem;">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" style="color:var(--color-terracotta); text-decoration:none; font-weight:600;">S'inscrire</a>
        </p>
    </div>
</div>
{% endblock %}
