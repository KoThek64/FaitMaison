{% extends 'base.html.twig' %}
{% block title %}Modifier — {{ recipe.title }}{% endblock %}

{% block body %}
<div style="max-width:42rem; margin:0 auto; padding:2.5rem 1.5rem 4rem;">
    <div style="margin-bottom:2rem;">
        <a href="{{ path('app_recipe_show', {id: recipe.id}) }}" style="font-family:var(--font-crimson); font-size:0.875rem; color:var(--color-terracotta); text-decoration:none; display:inline-flex; align-items:center; gap:0.375rem; margin-bottom:1rem;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Retour à la recette
        </a>
        <h1 style="font-size:2rem; margin-bottom:0.25rem;">Modifier la recette</h1>
        <p style="font-family:var(--font-crimson); color:var(--color-ink-muted); font-size:0.9375rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ recipe.title }}</p>
    </div>
    <div class="form-card">
        {{ form_start(form, {attr: {style: 'display:flex; flex-direction:column; gap:1.25rem;'}}) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn-primary" style="margin-top:0.5rem; align-self:flex-start; padding:0.75rem 2rem; font-size:1rem;">
            Enregistrer les modifications
        </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
