{% extends 'base.html.twig' %}
{% block title %}Nouvelle recette{% endblock %}

{% block body %}
<div style="max-width:42rem; margin:0 auto; padding:2.5rem 1.5rem 4rem;">
    <div style="margin-bottom:2rem;">
        <h1 style="font-size:2rem; margin-bottom:0.25rem;">Nouvelle recette</h1>
        <p style="font-family:var(--font-crimson); color:var(--color-ink-muted);">Partagez votre recette avec la communauté.</p>
    </div>
    <div class="form-card">
        {{ form_start(form, {attr: {style: 'display:flex; flex-direction:column; gap:1.25rem;'}}) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn-primary" style="margin-top:0.5rem; align-self:flex-start; padding:0.75rem 2rem; font-size:1rem;">
            Publier la recette
        </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
