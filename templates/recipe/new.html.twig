{% extends 'base.html.twig' %}
{% block title %}Nouvelle recette{% endblock %}

{% block body %}
<div style="max-width:48rem; margin:0 auto; padding:2.5rem 1.5rem 5rem;">

    {# En-tête #}
    <div style="margin-bottom:2.5rem;">
        <h1 style="font-size:2.25rem; margin-bottom:0.375rem;">Nouvelle recette</h1>
        <p style="font-family:var(--font-crimson); color:var(--color-ink-muted); font-size:1.0625rem;">
            Partagez votre création avec la communauté Fait Maison.
        </p>
    </div>

    {{ form_start(form) }}

    {# ── Section 1 : L'essentiel ── #}
    <div class="content-card" style="margin-bottom:1.25rem;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem; padding-bottom:1rem; border-bottom:1px solid var(--color-cream-border);">
            <span style="width:2rem; height:2rem; border-radius:50%; background:var(--color-terracotta-soft); color:var(--color-terracotta); font-family:var(--font-playfair); font-size:0.875rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;">1</span>
            <h2 style="font-size:1.125rem; margin:0;">L'essentiel</h2>
        </div>

        <div style="display:flex; flex-direction:column; gap:1.25rem;">
            <div>
                {{ form_label(form.title) }}
                {{ form_widget(form.title, {attr: {placeholder: 'Ex : Tarte aux pommes de grand-mère'}}) }}
                {{ form_errors(form.title) }}
            </div>
            <div>
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {attr: {placeholder: 'Décrivez votre recette en quelques lignes…', rows: 4}}) }}
                {{ form_errors(form.description) }}
            </div>
        </div>
    </div>

    {# ── Section 2 : La préparation ── #}
    <div class="content-card" style="margin-bottom:1.25rem;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem; padding-bottom:1rem; border-bottom:1px solid var(--color-cream-border);">
            <span style="width:2rem; height:2rem; border-radius:50%; background:var(--color-terracotta-soft); color:var(--color-terracotta); font-family:var(--font-playfair); font-size:0.875rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;">2</span>
            <h2 style="font-size:1.125rem; margin:0;">La préparation</h2>
        </div>

        <div>
            {{ form_label(form.steps) }}
            <p style="font-family:var(--font-crimson); font-size:0.875rem; color:var(--color-ink-muted); margin-bottom:0.5rem; margin-top:-0.25rem;">
                Décrivez chaque étape clairement, une par une.
            </p>
            {{ form_widget(form.steps, {attr: {placeholder: "1. Préchauffez le four à 180°C\n2. Mélangez la farine et le beurre…", rows: 10}}) }}
            {{ form_errors(form.steps) }}
        </div>
    </div>

    {# ── Section 3 : Les détails ── #}
    <div class="content-card" style="margin-bottom:1.25rem;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem; padding-bottom:1rem; border-bottom:1px solid var(--color-cream-border);">
            <span style="width:2rem; height:2rem; border-radius:50%; background:var(--color-terracotta-soft); color:var(--color-terracotta); font-family:var(--font-playfair); font-size:0.875rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;">3</span>
            <h2 style="font-size:1.125rem; margin:0;">Les détails</h2>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
            <div>
                {{ form_label(form.duration) }}
                {{ form_widget(form.duration, {attr: {placeholder: '45'}}) }}
                {{ form_errors(form.duration) }}
            </div>
            <div>
                {{ form_label(form.servings) }}
                {{ form_widget(form.servings, {attr: {placeholder: '4'}}) }}
                {{ form_errors(form.servings) }}
            </div>
            <div>
                {{ form_label(form.difficulty) }}
                {{ form_widget(form.difficulty) }}
                {{ form_errors(form.difficulty) }}
            </div>
            <div>
                {{ form_label(form.category) }}
                {{ form_widget(form.category) }}
                {{ form_errors(form.category) }}
            </div>
        </div>
    </div>

    {# ── Section 4 : Photo ── #}
    <div class="content-card" style="margin-bottom:2rem;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem; padding-bottom:1rem; border-bottom:1px solid var(--color-cream-border);">
            <span style="width:2rem; height:2rem; border-radius:50%; background:var(--color-cream-dark); color:var(--color-ink-muted); font-family:var(--font-playfair); font-size:0.875rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;">4</span>
            <h2 style="font-size:1.125rem; margin:0;">Photo</h2>
            <span style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); background:var(--color-cream); border:1px solid var(--color-cream-border); border-radius:999px; padding:0.1rem 0.625rem;">Optionnel</span>
        </div>

        {{ form_errors(form.imageFile) }}

        <label id="dropZone"
            style="display:block; border:2px dashed var(--color-cream-border); border-radius:1rem; padding:2.5rem 1.5rem; text-align:center; cursor:pointer; transition:border-color .2s, background .2s;"
            onmouseover="this.style.borderColor='var(--color-terracotta)'; this.style.background='var(--color-terracotta-soft)'"
            onmouseout="this.style.borderColor='var(--color-cream-border)'; this.style.background=''"
            ondragover="event.preventDefault(); this.style.borderColor='var(--color-terracotta)'; this.style.background='var(--color-terracotta-soft)'"
            ondragleave="this.style.borderColor='var(--color-cream-border)'; this.style.background=''"
            ondrop="event.preventDefault(); this.style.borderColor='var(--color-cream-border)'; this.style.background=''; handleDrop(event)">
            {{ form_widget(form.imageFile, {attr: {style: 'display:none', accept: 'image/*'}}) }}
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-sand); margin-bottom:0.75rem;"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p id="dropLabel" style="font-family:var(--font-playfair); font-size:1rem; color:var(--color-ink); margin-bottom:0.25rem;">Glissez votre photo ici</p>
            <p style="font-family:var(--font-crimson); font-size:0.875rem; color:var(--color-ink-muted); margin-bottom:1rem;">ou</p>
            <span style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.5rem 1.25rem; background:var(--color-espresso); color:var(--color-cream); border-radius:999px; font-family:var(--font-crimson); font-size:0.9375rem; pointer-events:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Choisir une photo
            </span>
            <p style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); margin-top:1rem;">JPG, PNG ou WebP · Max 5 Mo</p>
        </label>

        <div id="preview" style="margin-top:1rem;"></div>

        <script>
            const input = document.getElementById('{{ form.imageFile.vars.id }}');
            const preview = document.getElementById('preview');
            const dropLabel = document.getElementById('dropLabel');

            function showPreview(file) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.innerHTML = `<div style="position:relative; display:inline-block; border-radius:0.75rem; overflow:hidden; border:1px solid var(--color-cream-border);">
                        <img src="${e.target.result}" style="height:10rem; max-width:100%; object-fit:cover; display:block;">
                        <button type="button" onclick="clearImage()" style="position:absolute; top:0.25rem; right:0.25rem; width:1.5rem; height:1.5rem; border-radius:50%; background:rgba(26,13,6,0.7); border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; color:white; padding:0;">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>`;
                };
                reader.readAsDataURL(file);
                dropLabel.textContent = file.name;
            }

            function clearImage() {
                input.value = '';
                preview.innerHTML = '';
                dropLabel.textContent = 'Glissez votre photo ici';
            }

            input.addEventListener('change', () => {
                if (input.files[0]) showPreview(input.files[0]);
            });

            function handleDrop(event) {
                const file = Array.from(event.dataTransfer.files).find(f => f.type.startsWith('image/'));
                if (!file) return;
                const dt = new DataTransfer();
                dt.items.add(file);
                input.files = dt.files;
                showPreview(file);
            }
        </script>
    </div>

    {# ── Section 5 : Tags ── #}
    <div class="content-card" style="margin-bottom:2rem;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem; padding-bottom:1rem; border-bottom:1px solid var(--color-cream-border);">
            <span style="width:2rem; height:2rem; border-radius:50%; background:var(--color-cream-dark); color:var(--color-ink-muted); font-family:var(--font-playfair); font-size:0.875rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;">5</span>
            <h2 style="font-size:1.125rem; margin:0;">Tags</h2>
            <span style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); background:var(--color-cream); border:1px solid var(--color-cream-border); border-radius:999px; padding:0.1rem 0.625rem;">Optionnel</span>
        </div>

        {{ form_widget(form.tags, {attr: {size: 6}}) }}
        <p style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); margin-top:0.5rem;">
            Maintenez <kbd style="font-family:var(--font-crimson); background:var(--color-cream-dark); border:1px solid var(--color-cream-border); border-radius:0.25rem; padding:0.05rem 0.35rem; font-size:0.8125rem;">Ctrl</kbd> pour sélectionner plusieurs tags.
        </p>
        {{ form_errors(form.tags) }}
    </div>

    {# ── Actions ── #}
    <div style="display:flex; gap:0.875rem; justify-content:flex-end; align-items:center;">
        <button type="submit" name="action" value="draft" class="btn-ghost" style="padding:0.75rem 1.75rem; font-size:1rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.6;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Enregistrer en brouillon
        </button>
        <button type="submit" name="action" value="publish" class="btn-primary" style="padding:0.75rem 1.75rem; font-size:1rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Publier la recette
        </button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
