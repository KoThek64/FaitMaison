{% extends 'base.html.twig' %}

{% block title %}Recettes{% endblock %}

{% block body %}
    <div class="p-6 lg:p-10">
        <h1 class="font-playfair text-3xl font-bold text-gray-800 mb-6">Toutes les recettes</h1>

        {# Formulaire de filtre #}
        <div class="bg-white rounded-2xl shadow-sm p-6 mb-8">
            {{ form_start(form, {attr: {class: 'flex flex-wrap gap-4 items-end'}}) }}

                <div class="flex-1 min-w-40">
                    {{ form_label(form.search, 'Recherche', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.search, {attr: {class: 'w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm', placeholder: 'Poulet, pasta...'}}) }}
                </div>

                <div class="min-w-44">
                    {{ form_label(form.category, 'Catégorie', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.category, {attr: {class: 'w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm bg-white'}}) }}
                </div>

                <div class="min-w-44">
                    {{ form_label(form.difficulty, 'Difficulté', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.difficulty, {attr: {class: 'w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm bg-white'}}) }}
                </div>

                <div class="min-w-36">
                    {{ form_label(form.maxDuration, 'Durée max (min)', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.maxDuration, {attr: {class: 'w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm'}}) }}
                </div>

                <div class="min-w-36">
                    {{ form_label(form.servings, 'Portions', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.servings, {attr: {class: 'w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm'}}) }}
                </div>

                <button type="submit" class="px-6 py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-full font-medium transition-colors text-sm">
                    Filtrer
                </button>

            {{ form_end(form) }}
        </div>

        {# Grille de recettes #}
        {% if recipes is empty %}
            <div class="text-center py-20 text-gray-400">
                <div class="text-5xl mb-4">🔍</div>
                <p class="text-lg">Aucune recette ne correspond à votre recherche.</p>
                <a href="{{ path('app_recipe') }}" class="mt-4 inline-block text-orange-500 hover:underline text-sm">Réinitialiser les filtres</a>
            </div>
        {% else %}
            <p class="text-sm text-gray-500 mb-4">{{ recipes|length }} recette(s) trouvée(s)</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for recipe in recipes %}
                    <a href="{{ path('app_recipe_show', {id: recipe.id}) }}"
                        class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
                        <div class="h-44 bg-gradient-to-br from-orange-100 to-amber-100 flex items-center justify-center">
                            <span class="text-5xl">🍽️</span>
                        </div>
                        <div class="p-4">
                            <h3 class="font-playfair text-lg font-bold text-gray-800 mb-2 group-hover:text-orange-600 transition-colors line-clamp-1">
                                {{ recipe.title }}
                            </h3>
                            <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500 mb-3">
                                <span>🏷️ {{ recipe.category.name }}</span>
                                <span>•</span>
                                <span>⏱ {{ recipe.duration }} min</span>
                                <span>•</span>
                                <span>👤 {{ recipe.servings }} pers.</span>
                            </div>
                            <span class="inline-block px-3 py-1 rounded-full text-xs font-medium
                                {% if recipe.difficulty == 'facile' %}bg-green-100 text-green-700
                                {% elseif recipe.difficulty == 'moyen' %}bg-amber-100 text-amber-700
                                {% else %}bg-red-100 text-red-700{% endif %}">
                                {{ recipe.difficulty|capitalize }}
                            </span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
