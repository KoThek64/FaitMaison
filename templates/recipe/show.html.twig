{% extends 'base.html.twig' %}
{% block title %}{{ recipe.title }}{% endblock %}

{% block body %}
<div style="max-width:52rem; margin:0 auto; padding:2.5rem 1.5rem 4rem;">

    {# Breadcrumb #}
    <nav style="font-family:var(--font-crimson); font-size:0.875rem; color:var(--color-ink-muted); margin-bottom:1.5rem; display:flex; align-items:center; gap:0.5rem;">
        <a href="{{ path('app_recipe') }}" style="color:var(--color-terracotta); text-decoration:none; transition:opacity .15s;" onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">Recettes</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span style="color:var(--color-ink-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:20rem;">{{ recipe.title }}</span>
    </nav>

    {# Titre #}
    <h1 style="font-size:clamp(1.75rem, 4vw, 2.5rem); margin-bottom:1rem; line-height:1.2;">{{ recipe.title }}</h1>

    {# Métadonnées #}
    <div style="display:flex; flex-wrap:wrap; gap:1rem; align-items:center; margin-bottom:1.75rem; font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink-muted);">
        <span style="display:flex; align-items:center; gap:0.375rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            {{ recipe.category.name }}
        </span>
        <span style="color:var(--color-cream-border);">·</span>
        <span>⏱ {{ recipe.duration }} min</span>
        <span style="color:var(--color-cream-border);">·</span>
        <span>👤 {{ recipe.servings }} personnes</span>
        <span style="color:var(--color-cream-border);">·</span>
        <span>Par <a href="{{ path('app_profile_show', {id: recipe.author.id}) }}" style="color:var(--color-terracotta); text-decoration:none; font-weight:600; transition:opacity .15s;" onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">{{ recipe.author.username }}</a></span>
        <span class="badge {{ recipe.difficulty == 'facile' ? 'badge-easy' : (recipe.difficulty == 'moyen' ? 'badge-medium' : 'badge-hard') }}">
            {{ recipe.difficulty }}
        </span>
        {% for tag in recipe.tags %}
            <span style="font-family:var(--font-crimson); font-size:0.8125rem; padding:0.2rem 0.75rem; border-radius:999px; background:var(--color-cream); border:1px solid var(--color-cream-border); color:var(--color-ink-muted);">{{ tag.name }}</span>
        {% endfor %}
    </div>

    {# Photo #}
    {% if recipe.imageName %}
        <div style="height:20rem; border-radius:1.25rem; overflow:hidden; margin-bottom:2rem;">
            <img src="{{ asset('uploads/recipes/' ~ recipe.imageName) }}" alt="{{ recipe.title }}" style="width:100%; height:100%; object-fit:cover; display:block;">
        </div>
    {% else %}
        <div style="height:20rem; border-radius:1.25rem; background:linear-gradient(135deg, var(--color-parchment) 0%, var(--color-cream-dark) 60%, #D4B080 100%); display:flex; align-items:center; justify-content:center; margin-bottom:2rem; overflow:hidden; position:relative;">
            <span style="font-size:5rem; opacity:0.25; user-select:none;">🍽</span>
            <div style="position:absolute; bottom:0; left:0; right:0; height:6rem; background:linear-gradient(to top, rgba(44,24,16,0.05), transparent);"></div>
        </div>
    {% endif %}

    {# Actions #}
    <div style="display:flex; flex-wrap:wrap; gap:0.75rem; align-items:center; margin-bottom:2.5rem; padding-bottom:2rem; border-bottom:1px solid var(--color-cream-border);">
        {% if app.user == recipe.author %}
            <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="btn-ghost">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Modifier
            </a>
            <form method="post" action="{{ path('app_recipe_delete', {id: recipe.id}) }}" onsubmit="return confirm('Supprimer cette recette ?')">
                <button type="submit" class="btn-ghost" style="border-color:#DFB0A8; color:#9B3220;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Supprimer
                </button>
            </form>
        {% endif %}

        {% if app.user %}
            {# Bouton like #}
            <form method="post" action="{{ path('app_like_toggle', {id: recipe.id}) }}">
                <button type="submit"
                    style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.625rem 1.25rem; border-radius:0.625rem; font-family:var(--font-crimson); font-size:0.9375rem; font-weight:600; cursor:pointer; transition:all .2s; border:1px solid {{ isLiked ? '#DFB0A8' : 'var(--color-cream-border)' }}; background:{{ isLiked ? '#FAF0EE' : 'transparent' }}; color:{{ isLiked ? '#9B3220' : 'var(--color-ink-muted)' }};">
                    {{ isLiked ? '♥' : '♡' }}
                    {{ recipe.likes|length }}
                </button>
            </form>

            {# Bouton favori #}
            <form method="post" action="{{ path('app_favorite_toggle', {id: recipe.id}) }}">
                <button type="submit" class="{{ isFavorite ? 'btn-primary' : 'btn-ghost' }}">
                    {{ isFavorite ? '★' : '☆' }} {{ isFavorite ? 'Favori' : 'Ajouter aux favoris' }}
                </button>
            </form>
        {% endif %}

        <div style="margin-left:auto; font-family:var(--font-crimson); font-size:1rem; color:{{ average ? 'var(--color-gold)' : 'var(--color-sand)' }}; font-weight:600;">
            ★ {{ average ? average ~ ' / 5' : 'Pas encore noté' }}
        </div>
    </div>

    {# Description #}
    <div class="content-card" style="margin-bottom:1.5rem;">
        <h2 style="font-size:1.25rem; margin-bottom:0.875rem;">Description</h2>
        <p style="font-family:var(--font-crimson); font-size:1.0625rem; color:var(--color-ink-muted); line-height:1.8;">{{ recipe.description }}</p>
    </div>

    {# Étapes #}
    <div class="content-card" style="margin-bottom:2.5rem;">
        <h2 style="font-size:1.25rem; margin-bottom:0.875rem;">Préparation</h2>
        <div style="font-family:var(--font-crimson); font-size:1.0625rem; color:var(--color-ink-muted); line-height:1.8; white-space:pre-line;">{{ recipe.steps }}</div>
    </div>

    {# Carte auteur #}
    <a href="{{ path('app_profile_show', {id: recipe.author.id}) }}"
        style="display:flex; align-items:center; gap:1rem; background:white; border-radius:1.25rem; padding:1.125rem 1.375rem; margin-bottom:1.5rem; box-shadow:0 2px 8px rgba(44,24,16,0.06), 0 0 0 1px rgba(44,24,16,0.04); text-decoration:none; transition:box-shadow .2s, transform .2s;"
        onmouseover="this.style.boxShadow='0 8px 24px rgba(44,24,16,0.1), 0 0 0 1px rgba(44,24,16,0.06)'; this.style.transform='translateY(-2px)'"
        onmouseout="this.style.boxShadow='0 2px 8px rgba(44,24,16,0.06), 0 0 0 1px rgba(44,24,16,0.04)'; this.style.transform='translateY(0)'">
        {% if recipe.author.avatarName %}
            <img src="{{ asset('uploads/recipes/' ~ recipe.author.avatarName) }}" alt="{{ recipe.author.username }}"
                style="width:3rem; height:3rem; border-radius:50%; object-fit:cover; flex-shrink:0; border:1px solid var(--color-cream-border);">
        {% else %}
            <div style="width:3rem; height:3rem; border-radius:50%; background:linear-gradient(135deg, var(--color-terracotta), var(--color-terracotta-dark)); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:1.125rem; font-weight:700; color:var(--color-cream); flex-shrink:0;">
                {{ recipe.author.username|first|upper }}
            </div>
        {% endif %}
        <div style="flex:1; min-width:0;">
            <div style="font-family:var(--font-crimson); font-size:0.75rem; color:var(--color-sand); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.125rem;">Recette de</div>
            <div style="font-family:var(--font-playfair); font-size:1rem; font-weight:600; color:var(--color-ink);">{{ recipe.author.username }}</div>
        </div>
        <svg style="color:var(--color-sand); flex-shrink:0;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </a>

    {# Notation #}
    {% if app.user and app.user != recipe.author %}
        <div id="rating" style="display:inline-block; background:linear-gradient(135deg, var(--color-parchment), white); border:1px solid var(--color-cream-border); border-radius:1.25rem; padding:1.25rem 1.5rem;">
            <p style="font-family:var(--font-crimson); font-size:0.8125rem; letter-spacing:0.05em; text-transform:uppercase; color:var(--color-ink-muted); margin-bottom:0.5rem;">
                {{ userRating ? 'Votre note' : 'Noter cette recette' }}
            </p>
            <form method="post" action="{{ path('app_recipe_rating', {id: recipe.id}) }}">
                <div class="star-group" style="display:flex; gap:0.125rem; flex-direction:row-reverse;">
                    {% for i in 5..1 %}
                        <input type="radio" name="score" value="{{ i }}" id="star-{{ i }}" class="star-input"
                            {{ userRating and userRating.score == i ? 'checked' : '' }}
                            onchange="sessionStorage.setItem('restoreScroll', window.scrollY); this.closest('form').submit()">
                        <label for="star-{{ i }}" class="star-label" title="{{ i }} étoile{{ i > 1 ? 's' : '' }}"
                            style="{{ userRating and userRating.score >= i ? 'color:var(--color-gold);' : '' }}">★</label>
                    {% endfor %}
                </div>
            </form>
        </div>
    {% endif %}


    {# ── Commentaires ── #}
    <div style="margin-top:2.5rem;">
        <div class="section-heading">
            <h2 style="font-size:1.25rem;">Commentaires <span style="font-family:var(--font-crimson); font-size:1rem; font-weight:400; color:var(--color-sand);">{{ recipe.comments|length }}</span></h2>
        </div>

        {# Formulaire #}
        {% if app.user %}
            {% if app.user != recipe.author %}
                <form method="post" action="{{ path('app_comment_add', {id: recipe.id}) }}" style="margin-bottom:2rem;">
                    <div style="display:flex; gap:0.75rem; align-items:flex-start;">
                        {% if app.user.avatarName %}
                            <img src="{{ asset('uploads/recipes/' ~ app.user.avatarName) }}" alt="{{ app.user.username }}"
                                style="width:2.5rem; height:2.5rem; border-radius:50%; object-fit:cover; flex-shrink:0; border:1px solid var(--color-cream-border);">
                        {% else %}
                            <div style="width:2.5rem; height:2.5rem; border-radius:50%; background:var(--color-terracotta); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:1rem; font-weight:700; color:var(--color-cream); flex-shrink:0;">
                                {{ app.user.username|first|upper }}
                            </div>
                        {% endif %}
                        <div style="flex:1;">
                            <textarea name="content" rows="3" placeholder="Partagez votre avis sur cette recette…"
                                style="resize:vertical; min-height:5rem;"></textarea>
                            <div style="display:flex; justify-content:flex-end; margin-top:0.5rem;">
                                <button type="submit" class="btn-primary" style="padding:0.5rem 1.25rem; font-size:0.9375rem;">
                                    Publier
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            {% endif %}
        {% else %}
            <p style="font-family:var(--font-crimson); color:var(--color-sand); font-size:0.9375rem; margin-bottom:1.5rem;">
                <a href="{{ path('app_login') }}" style="color:var(--color-terracotta);">Connectez-vous</a> pour laisser un commentaire.
            </p>
        {% endif %}

        {# Liste des commentaires #}
        {% if recipe.comments is empty %}
            <p style="font-family:var(--font-crimson); color:var(--color-sand); font-size:0.9375rem; padding:1rem 0;">Aucun commentaire pour l'instant. Soyez le premier !</p>
        {% else %}
            <div style="display:flex; flex-direction:column; gap:1rem;">
                {% for comment in recipe.comments %}
                    <div style="display:flex; gap:0.875rem; align-items:flex-start; background:white; border-radius:1rem; padding:1.125rem 1.25rem; box-shadow:0 1px 4px rgba(44,24,16,0.05);">
                        {# Avatar auteur #}
                        {% if comment.author.avatarName %}
                            <img src="{{ asset('uploads/recipes/' ~ comment.author.avatarName) }}" alt="{{ comment.author.username }}"
                                style="width:2.25rem; height:2.25rem; border-radius:50%; object-fit:cover; flex-shrink:0; border:1px solid var(--color-cream-border);">
                        {% else %}
                            <div style="width:2.25rem; height:2.25rem; border-radius:50%; background:var(--color-terracotta); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:0.875rem; font-weight:700; color:var(--color-cream); flex-shrink:0;">
                                {{ comment.author.username|first|upper }}
                            </div>
                        {% endif %}

                        <div style="flex:1; min-width:0;">
                            <div style="display:flex; align-items:baseline; gap:0.625rem; margin-bottom:0.375rem; flex-wrap:wrap;">
                                <a href="{{ path('app_profile_show', {id: comment.author.id}) }}"
                                    style="font-family:var(--font-playfair); font-size:0.9375rem; font-weight:600; color:var(--color-ink); text-decoration:none; transition:color .15s;"
                                    onmouseover="this.style.color='var(--color-terracotta)'"
                                    onmouseout="this.style.color='var(--color-ink)'">{{ comment.author.username }}</a>
                                <span style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-sand);">{{ comment.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }}</span>
                            </div>
                            <p style="font-family:var(--font-crimson); font-size:1rem; color:var(--color-ink-muted); line-height:1.6; margin:0;">{{ comment.content }}</p>
                        </div>

                        {# Bouton supprimer (auteur du commentaire uniquement) #}
                        {% if app.user == comment.author %}
                            <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" style="flex-shrink:0;"
                                onsubmit="return confirm('Supprimer ce commentaire ?')">
                                <button type="submit" title="Supprimer"
                                    style="background:transparent; border:none; cursor:pointer; padding:0.25rem; color:var(--color-sand); transition:color .15s; line-height:1;"
                                    onmouseover="this.style.color='#9B3220'"
                                    onmouseout="this.style.color='var(--color-sand)'">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                </button>
                            </form>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
