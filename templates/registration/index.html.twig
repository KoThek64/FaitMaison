{% extends 'base.html.twig' %}
{% block title %}Inscription{% endblock %}

{% block body %}
<div style="min-height:80vh; display:flex; align-items:center; justify-content:center; padding:2rem 1rem;">
    <div style="width:100%; max-width:26rem;">

        <div style="text-align:center; margin-bottom:2rem;">
            <div style="font-family:var(--font-playfair); font-size:2.5rem; font-weight:700; font-style:italic; color:var(--color-terracotta); line-height:1; margin-bottom:0.5rem;">Fait Maison</div>
            <div style="width:2.5rem; height:2px; background:var(--color-terracotta); margin:0 auto 1rem; border-radius:1px;"></div>
            <h1 style="font-size:1.5rem; margin-bottom:0.25rem;">Créer un compte</h1>
            <p style="font-family:var(--font-crimson); color:var(--color-ink-muted); font-size:0.9375rem;">Rejoignez la communauté Fait Maison</p>
        </div>

        <div class="form-card">
            {{ form_start(form, {attr: {style: 'display:flex; flex-direction:column; gap:1.125rem;'}}) }}

            <div>
                {{ form_label(form.email, 'Adresse e-mail') }}
                {{ form_widget(form.email, {attr: {placeholder: 'vous@exemple.fr'}}) }}
                {{ form_errors(form.email) }}
            </div>
            <div>
                {{ form_label(form.username, "Nom d'utilisateur") }}
                {{ form_widget(form.username, {attr: {placeholder: 'ChefCuistot42'}}) }}
                {{ form_errors(form.username) }}
            </div>
            <div>
                {{ form_row(form.plainPassword.first, {attr: {placeholder: '8 caractères minimum'}}) }}
            </div>
            <div>
                {{ form_row(form.plainPassword.second, {attr: {placeholder: 'Répétez le mot de passe'}}) }}
            </div>

            <button type="submit" class="btn-primary" style="width:100%; padding:0.875rem; font-size:1rem; margin-top:0.25rem;">
                Créer mon compte
            </button>

            {{ form_end(form) }}
        </div>

        <p style="text-align:center; font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink-muted); margin-top:1.5rem;">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" style="color:var(--color-terracotta); text-decoration:none; font-weight:600;">Se connecter</a>
        </p>
    </div>
</div>
{% endblock %}
