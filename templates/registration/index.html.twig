{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center px-4 py-12">
        <div class="bg-white rounded-2xl shadow-lg p-8 w-full max-w-md">
            <h1 class="font-playfair text-3xl font-bold text-gray-800 mb-1 text-center">Inscription</h1>
            <p class="text-gray-500 text-sm text-center mb-6">Rejoignez la communauté Fait Maison</p>

            {{ form_start(form, {attr: {class: 'space-y-4'}}) }}

            <div>
                {{ form_label(form.email, 'Email', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.email, {attr: {class: 'w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <div>
                {{ form_label(form.username, "Nom d'utilisateur", {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.username, {attr: {class: 'w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm'}}) }}
                {{ form_errors(form.username) }}
            </div>

            <div>
                {{ form_label(form.plainPassword, 'Mot de passe', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.plainPassword, {attr: {class: 'w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-300 text-sm'}}) }}
                {{ form_errors(form.plainPassword) }}
            </div>

            <button type="submit" class="w-full py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-full font-medium transition-colors">
                Créer mon compte
            </button>

            {{ form_end(form) }}

            <p class="text-center text-sm text-gray-500 mt-4">
                Déjà un compte ?
                <a href="{{ path('app_login') }}" class="text-orange-600 hover:underline font-medium">Connexion</a>
            </p>
        </div>
    </div>
{% endblock %}
