{% extends 'base.html.twig' %}
{% block title %}Fil d'actualité{% endblock %}

{% block body %}

    {# ── Bandeau titre ── #}
    <div style="background:linear-gradient(135deg, var(--color-espresso) 0%, var(--color-espresso-mid) 50%, #3D2015 100%); padding:3rem 2rem 2.75rem; position:relative; overflow:hidden;">

        <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(250,244,232,0.025) 1px, transparent 1px); background-size:18px 18px; pointer-events:none;"></div>
        <div style="position:absolute; top:-5rem; right:-5rem; width:18rem; height:18rem; border-radius:50%; background:radial-gradient(circle, rgba(196,98,45,0.15) 0%, transparent 70%); pointer-events:none;"></div>

        <div style="position:relative; z-index:1; max-width:80rem; margin:0 auto;">
            <div style="display:inline-flex; align-items:center; gap:0.75rem; margin-bottom:0.875rem;">
                <span style="height:1px; width:2rem; background:var(--color-terracotta); display:block;"></span>
                <span style="font-family:var(--font-crimson); font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--color-terracotta-soft);">Abonnements</span>
            </div>
            <h1 style="font-family:var(--font-playfair); font-size:clamp(1.75rem,3.5vw,2.5rem); font-weight:700; color:var(--color-cream); line-height:1.15; margin-bottom:0.5rem;">
                Fil d'actualité
            </h1>
            <p style="font-family:var(--font-crimson); font-size:1.0625rem; color:rgba(250,244,232,0.5);">
                Les dernières recettes des personnes que vous suivez
            </p>
        </div>
    </div>

    {# ── Contenu ── #}
    <div style="padding:2.5rem 2rem 5rem; max-width:80rem; margin:0 auto;">

        {% if pagination.totalItemCount == 0 %}

            {# État vide #}
            <div style="text-align:center; padding:5rem 2rem;">
                <div style="width:5rem; height:5rem; border-radius:50%; background:linear-gradient(135deg, var(--color-terracotta) 0%, var(--color-terracotta-dark) 100%); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem; opacity:0.3;">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h2 style="font-family:var(--font-playfair); font-size:1.5rem; color:var(--color-ink); margin-bottom:0.75rem;">Votre fil est vide</h2>
                <p style="font-family:var(--font-crimson); font-size:1.0625rem; color:var(--color-ink-muted); max-width:28rem; margin:0 auto 2.5rem; line-height:1.6;">
                    Suivez des cuisinier·ères pour voir leurs nouvelles recettes apparaître ici.
                </p>
                <a href="{{ path('app_recipe') }}" class="btn-primary" style="display:inline-flex;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    Découvrir des recettes
                </a>
            </div>

        {% else %}

            {# Compteur + page #}
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.75rem; flex-wrap:wrap; gap:0.5rem;">
                <p style="font-family:var(--font-crimson); font-size:0.875rem; color:var(--color-ink-muted);">
                    {{ pagination.totalItemCount }} recette{{ pagination.totalItemCount > 1 ? 's' : '' }} de vos abonnements
                </p>
                {% if pagination.pageCount > 1 %}
                    <p style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-sand);">
                        Page {{ pagination.currentPageNumber }} / {{ pagination.pageCount }}
                    </p>
                {% endif %}
            </div>

            {# Grille de recettes #}
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(17rem, 1fr)); gap:1.5rem; margin-bottom:3rem;">
                {% for recipe in pagination %}
                    <div class="recipe-card" style="display:flex; flex-direction:column;">
                        <a href="{{ path('app_recipe_show', {id: recipe.id}) }}" style="text-decoration:none; display:block; flex:1;">
                            <div class="recipe-card-thumb">
                                {% if recipe.imageName %}
                                    <img src="{{ asset('uploads/recipes/' ~ recipe.imageName) }}" alt="{{ recipe.title }}" style="width:100%; height:100%; object-fit:cover; display:block;">
                                {% else %}
                                    <span style="font-size:3rem; opacity:0.35; position:relative; z-index:1;">🍽</span>
                                {% endif %}

                                {# Badge date #}
                                <div style="position:absolute; top:0.625rem; left:0.625rem; z-index:2; background:rgba(26,13,6,0.65); backdrop-filter:blur(6px); border-radius:0.5rem; padding:0.25rem 0.625rem;">
                                    <span style="font-family:var(--font-crimson); font-size:0.75rem; color:rgba(250,244,232,0.8);">
                                        {{ recipe.createdAt|date('d/m/Y') }}
                                    </span>
                                </div>
                            </div>
                            <div style="padding:1.25rem 1.25rem 0.875rem;">
                                <h3 style="font-family:var(--font-playfair); font-size:1.0625rem; font-weight:600; color:var(--color-ink); margin-bottom:0.5rem; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                    {{ recipe.title }}
                                </h3>
                                <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center; font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); margin-bottom:0.75rem;">
                                    <span>{{ recipe.category.name }}</span>
                                    <span style="color:var(--color-cream-border);">·</span>
                                    <span>{{ recipe.duration }} min</span>
                                    <span style="color:var(--color-cream-border);">·</span>
                                    <span>{{ recipe.servings }} pers.</span>
                                </div>
                                <span class="badge {{ recipe.difficulty == 'facile' ? 'badge-easy' : (recipe.difficulty == 'moyen' ? 'badge-medium' : 'badge-hard') }}">
                                    {{ recipe.difficulty }}
                                </span>
                            </div>
                        </a>

                        {# Auteur #}
                        <a href="{{ path('app_profile_show', {id: recipe.author.id}) }}"
                            style="display:flex; align-items:center; gap:0.625rem; padding:0.75rem 1.25rem; border-top:1px solid var(--color-cream-border); text-decoration:none; transition:background .15s; border-radius:0 0 1.25rem 1.25rem;"
                            onmouseover="this.style.background='var(--color-cream)'"
                            onmouseout="this.style.background='transparent'">
                            {% if recipe.author.avatarName %}
                                <img src="{{ asset('uploads/recipes/' ~ recipe.author.avatarName) }}" alt="{{ recipe.author.username }}"
                                    style="width:1.5rem; height:1.5rem; border-radius:50%; object-fit:cover; flex-shrink:0;">
                            {% else %}
                                <div style="width:1.5rem; height:1.5rem; border-radius:50%; background:var(--color-terracotta); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:0.625rem; font-weight:700; color:var(--color-cream); flex-shrink:0;">
                                    {{ recipe.author.username|first|upper }}
                                </div>
                            {% endif %}
                            <span style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; flex:1;">{{ recipe.author.username }}</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--color-sand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                    </div>
                {% endfor %}
            </div>

            {# ── Pagination ── #}
            {% if pagination.pageCount > 1 %}
                <nav style="display:flex; justify-content:center; align-items:center; gap:0.375rem;">

                    {# Précédent #}
                    {% if pagination.currentPageNumber > 1 %}
                        <a href="{{ path('app_feed', {page: pagination.currentPageNumber - 1}) }}"
                            style="display:inline-flex; align-items:center; gap:0.375rem; padding:0.5rem 1rem; border-radius:0.625rem; border:1px solid var(--color-cream-border); font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink-muted); text-decoration:none; transition:all .15s; background:white;"
                            onmouseover="this.style.borderColor='var(--color-terracotta)'; this.style.color='var(--color-terracotta)'"
                            onmouseout="this.style.borderColor='var(--color-cream-border)'; this.style.color='var(--color-ink-muted)'">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                            Précédent
                        </a>
                    {% endif %}

                    {# Numéros de pages #}
                    {% for p in 1..pagination.pageCount %}
                        {% if p == pagination.currentPageNumber %}
                            <span style="display:inline-flex; align-items:center; justify-content:center; width:2.25rem; height:2.25rem; border-radius:0.5rem; background:var(--color-terracotta); font-family:var(--font-crimson); font-size:0.9375rem; font-weight:600; color:var(--color-cream);">
                                {{ p }}
                            </span>
                        {% elseif p == 1 or p == pagination.pageCount or (p >= pagination.currentPageNumber - 2 and p <= pagination.currentPageNumber + 2) %}
                            <a href="{{ path('app_feed', {page: p}) }}"
                                style="display:inline-flex; align-items:center; justify-content:center; width:2.25rem; height:2.25rem; border-radius:0.5rem; border:1px solid var(--color-cream-border); font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink-muted); text-decoration:none; transition:all .15s; background:white;"
                                onmouseover="this.style.borderColor='var(--color-terracotta)'; this.style.color='var(--color-terracotta)'"
                                onmouseout="this.style.borderColor='var(--color-cream-border)'; this.style.color='var(--color-ink-muted)'">
                                {{ p }}
                            </a>
                        {% elseif p == pagination.currentPageNumber - 3 or p == pagination.currentPageNumber + 3 %}
                            <span style="font-family:var(--font-crimson); color:var(--color-sand); padding:0 0.25rem;">…</span>
                        {% endif %}
                    {% endfor %}

                    {# Suivant #}
                    {% if pagination.currentPageNumber < pagination.pageCount %}
                        <a href="{{ path('app_feed', {page: pagination.currentPageNumber + 1}) }}"
                            style="display:inline-flex; align-items:center; gap:0.375rem; padding:0.5rem 1rem; border-radius:0.625rem; border:1px solid var(--color-cream-border); font-family:var(--font-crimson); font-size:0.9375rem; color:var(--color-ink-muted); text-decoration:none; transition:all .15s; background:white;"
                            onmouseover="this.style.borderColor='var(--color-terracotta)'; this.style.color='var(--color-terracotta)'"
                            onmouseout="this.style.borderColor='var(--color-cream-border)'; this.style.color='var(--color-ink-muted)'">
                            Suivant
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                    {% endif %}

                </nav>
            {% endif %}

        {% endif %}

    </div>

    {# ── Suggestions ── #}
    {% if recommended is not empty %}
        <div style="background:white; border-top:1px solid var(--color-cream-border); padding:3rem 2rem 5rem;">
            <div style="max-width:80rem; margin:0 auto;">

                <div style="display:flex; align-items:baseline; gap:1rem; margin-bottom:1.75rem;">
                    <h2 style="font-family:var(--font-playfair); font-size:1.375rem; font-weight:700; color:var(--color-ink);">
                        Vous pourriez aimer
                    </h2>
                    <span style="font-family:var(--font-crimson); font-size:0.875rem; color:var(--color-sand);">
                        Basé sur vos likes
                    </span>
                </div>

                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(17rem, 1fr)); gap:1.5rem;">
                    {% for recipe in recommended %}
                        <div class="recipe-card" style="display:flex; flex-direction:column;">
                            <a href="{{ path('app_recipe_show', {id: recipe.id}) }}" style="text-decoration:none; display:block; flex:1;">
                                <div class="recipe-card-thumb">
                                    {% if recipe.imageName %}
                                        <img src="{{ asset('uploads/recipes/' ~ recipe.imageName) }}" alt="{{ recipe.title }}" style="width:100%; height:100%; object-fit:cover; display:block;">
                                    {% else %}
                                        <span style="font-size:3rem; opacity:0.35; position:relative; z-index:1;">🍽</span>
                                    {% endif %}

                                    {# Badge nombre de likes #}
                                    {% if recipe.likes|length > 0 %}
                                        <div style="position:absolute; top:0.625rem; right:0.625rem; z-index:2; background:rgba(26,13,6,0.65); backdrop-filter:blur(6px); border-radius:0.5rem; padding:0.25rem 0.625rem; display:flex; align-items:center; gap:0.3rem;">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="rgba(196,98,45,0.9)" stroke="none"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                            <span style="font-family:var(--font-crimson); font-size:0.75rem; color:rgba(250,244,232,0.9);">{{ recipe.likes|length }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                                <div style="padding:1.25rem 1.25rem 0.875rem;">
                                    <h3 style="font-family:var(--font-playfair); font-size:1.0625rem; font-weight:600; color:var(--color-ink); margin-bottom:0.5rem; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                        {{ recipe.title }}
                                    </h3>
                                    <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center; font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); margin-bottom:0.75rem;">
                                        <span>{{ recipe.category.name }}</span>
                                        <span style="color:var(--color-cream-border);">·</span>
                                        <span>{{ recipe.duration }} min</span>
                                        <span style="color:var(--color-cream-border);">·</span>
                                        <span>{{ recipe.servings }} pers.</span>
                                    </div>
                                    <span class="badge {{ recipe.difficulty == 'facile' ? 'badge-easy' : (recipe.difficulty == 'moyen' ? 'badge-medium' : 'badge-hard') }}">
                                        {{ recipe.difficulty }}
                                    </span>
                                </div>
                            </a>

                            {# Auteur #}
                            <a href="{{ path('app_profile_show', {id: recipe.author.id}) }}"
                                style="display:flex; align-items:center; gap:0.625rem; padding:0.75rem 1.25rem; border-top:1px solid var(--color-cream-border); text-decoration:none; transition:background .15s; border-radius:0 0 1.25rem 1.25rem;"
                                onmouseover="this.style.background='var(--color-cream)'"
                                onmouseout="this.style.background='transparent'">
                                {% if recipe.author.avatarName %}
                                    <img src="{{ asset('uploads/recipes/' ~ recipe.author.avatarName) }}" alt="{{ recipe.author.username }}"
                                        style="width:1.5rem; height:1.5rem; border-radius:50%; object-fit:cover; flex-shrink:0;">
                                {% else %}
                                    <div style="width:1.5rem; height:1.5rem; border-radius:50%; background:var(--color-terracotta); display:flex; align-items:center; justify-content:center; font-family:var(--font-playfair); font-size:0.625rem; font-weight:700; color:var(--color-cream); flex-shrink:0;">
                                        {{ recipe.author.username|first|upper }}
                                    </div>
                                {% endif %}
                                <span style="font-family:var(--font-crimson); font-size:0.8125rem; color:var(--color-ink-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; flex:1;">{{ recipe.author.username }}</span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--color-sand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                            </a>
                        </div>
                    {% endfor %}
                </div>

            </div>
        </div>
    {% endif %}

{% endblock %}
